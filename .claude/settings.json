{
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__send_message"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/lab/traversal_layered/study_check/hooks/session_start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/lab/traversal_layered/study_check/hooks/pre_tool.sh\"",
            "timeout": 2400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/lab/traversal_layered/study_check/hooks/stop.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
