+// Coronado patch e: build the tile light grid for the view about to be rendered.
+// Lights are bounded by their range sphere in view space (spots too: conservative). In the plane of one screen axis
+// and the view depth the sphere is a circle, and the two tangent lines from the eye give its exact extent in
+// tan(angle) units, which is what the shader computes per pixel as view.xy / -view.z.
+static void _light_grid_axis_range(float p_center, float p_depth, float p_radius, float p_scale, float p_offset, uint32_t p_tiles, uint32_t &r_from, uint32_t &r_to) {
+	r_from = 0;
+	r_to = p_tiles - 1;
+	const float dist_sq = p_center * p_center + p_depth * p_depth;
+	if (dist_sq <= p_radius * p_radius * 1.0001f) {
+		return; // The eye is inside the circle: every tile on this axis.
+	}
+	const float theta = Math::atan2(p_center, p_depth); // 0 = straight ahead.
+	const float alpha = Math::asin(p_radius / Math::sqrt(dist_sq));
+	const float limit = float(Math::PI) * 0.5f - 0.01f;
+	float lo = theta - alpha;
+	float hi = theta + alpha;
+	if (lo >= limit || hi <= -limit) {
+		return; // Entirely beside or behind the eye on this axis; the light culling normally removes these.
+	}
+	// Unbounded sides stay at the screen edge.
+	float u_lo = lo <= -limit ? -1e30f : Math::tan(lo) * p_scale + p_offset;
+	float u_hi = hi >= limit ? 1e30f : Math::tan(hi) * p_scale + p_offset;
+	if (p_scale < 0.0f) {
+		SWAP(u_lo, u_hi);
+		if (lo <= -limit) {
+			u_hi = 1e30f;
+		}
+		if (hi >= limit) {
+			u_lo = -1e30f;
+		}
+	}
+	const float t_lo = Math::floor(u_lo * float(p_tiles));
+	const float t_hi = Math::floor(u_hi * float(p_tiles));
+	r_from = uint32_t(CLAMP(t_lo, 0.0f, float(p_tiles - 1)));
+	r_to = uint32_t(CLAMP(t_hi, 0.0f, float(p_tiles - 1)));
+	if (t_hi < 0.0f || t_lo > float(p_tiles - 1)) {
+		r_from = 1; // Off screen on this axis: an empty range.
+		r_to = 0;
+	}
+}
