+	uint flags; // 1 = a light in the grid has a cull mask or is baked static (per-instance tests needed).
+	float z_scale; // depth slice = view depth * z_scale
+	uint pad1;
+	uint pad2;
+	uvec4 tiles[LIGHT_GRID_W * LIGHT_GRID_H];
+	uvec4 slices[LIGHT_GRID_Z];
+}
