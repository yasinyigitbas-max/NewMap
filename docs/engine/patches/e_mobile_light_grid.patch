+void RenderForwardMobile::_update_light_grid(const RenderDataRD *p_render_data) {
+	RendererRD::LightStorage *light_storage = RendererRD::LightStorage::get_singleton();
+	const bool wanted = GLOBAL_GET_CACHED(bool, "rendering/lights_and_shadows/mobile_light_grid");
+	const bool single_view = p_render_data->render_buffers.is_null() || p_render_data->render_buffers->get_view_count() == 1;
+	scene_state.light_grid_active = wanted && single_view && !p_render_data->scene_data->cam_orthogonal;
+	if (!scene_state.light_grid_active) {
+		return;
+	}
+
+	SceneState::LightGridData &grid = scene_state.light_grid;
+	const Projection &proj = p_render_data->scene_data->cam_projection;
+	// ndc.x = (m00 * x + m20 * z) / -z = m00 * (x / -z) - m20, and the same for y; uv = ndc * 0.5 + 0.5.
+	grid.uv_scale[0] = 0.5f * proj.columns[0][0];
+	grid.uv_scale[1] = 0.5f * proj.columns[1][1];
+	grid.uv_offset[0] = 0.5f - 0.5f * proj.columns[2][0];
+	grid.uv_offset[1] = 0.5f - 0.5f * proj.columns[2][1];
+	grid.flags = 0;
+	memset(grid.tiles, 0, sizeof(grid.tiles));
+	memset(grid.slices, 0, sizeof(grid.slices));
+
+	// Depth slices: equal length, from the eye to the far side of the farthest light. The last slice is kept
+	// empty so that everything beyond gets no lights.
+	float z_far = 1.0f;
+	for (uint32_t type = 0; type < 2; type++) {
+		const uint32_t count = MIN(type == 0 ? light_storage->get_omni_light_data_count() : light_storage->get_spot_light_data_count(), 32u);
+		for (uint32_t i = 0; i < count; i++) {
+			float position[3];
+			float radius;
+			light_storage->get_light_data_sphere(type == 1, i, position, radius);
+			z_far = MAX(z_far, -position[2] + radius);
+		}
+	}
+	grid.z_scale = float(SceneState::LIGHT_GRID_Z - 1) / z_far;
+
+	for (uint32_t type = 0; type < 2; type++) {
+		const uint32_t count = MIN(type == 0 ? light_storage->get_omni_light_data_count() : light_storage->get_spot_light_data_count(), 32u);
+		for (uint32_t i = 0; i < count; i++) {
+			float position[3];
+			float radius;
+			if (light_storage->get_light_data_sphere(type == 1, i, position, radius)) {
+				grid.flags = 1;
+			}
+			const float depth = -position[2]; // View space looks down -Z.
+			uint32_t x0, x1, y0, y1;
+			_light_grid_axis_range(position[0], depth, radius, grid.uv_scale[0], grid.uv_offset[0], SceneState::LIGHT_GRID_W, x0, x1);
+			_light_grid_axis_range(position[1], depth, radius, grid.uv_scale[1], grid.uv_offset[1], SceneState::LIGHT_GRID_H, y0, y1);
+			const uint32_t bit = 1u << i;
+			const int32_t z0 = CLAMP(int32_t(Math::floor((depth - radius) * grid.z_scale)), 0, int32_t(SceneState::LIGHT_GRID_Z) - 2);
+			const int32_t z1 = CLAMP(int32_t(Math::floor((depth + radius) * grid.z_scale)), -1, int32_t(SceneState::LIGHT_GRID_Z) - 2);
+			for (int32_t z = z0; z <= z1; z++) {
+				grid.slices[z][type] |= bit;
+			}
+			for (uint32_t y = y0; y <= y1 && y1 < SceneState::LIGHT_GRID_H; y++) {
+				for (uint32_t x = x0; x <= x1 && x1 < SceneState::LIGHT_GRID_W; x++) {
+					grid.tiles[y * SceneState::LIGHT_GRID_W + x][type] |= bit;
+				}
+			}
+		}
+	}
+
+	RD::get_singleton()->buffer_update(scene_state.light_grid_buffer, 0, sizeof(SceneState::LightGridData), &grid);
+}
