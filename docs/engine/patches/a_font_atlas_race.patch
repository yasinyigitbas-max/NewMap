+
+// Coronado patch a (font atlas race): the atlas image handed to the RenderingServer must not be the one the text
+// server keeps rasterizing glyphs into. With a separate render thread the upload is only queued; when the next glyph
+// is written, Image::ptrw() forks the shared pixel buffer (copy-on-write) and for the duration of that copy the live
+// image's data pointer is null, so a queued texture_2d_update that runs meanwhile sees an empty image and is dropped
+// ("p_image.is_null() || p_image->is_empty()"). duplicate() makes a second Image that shares the pixel buffer (no
+// pixel copy here); it is never written to again, so the render thread always sees a complete image.
+static _FORCE_INLINE_ Ref<Image> _atlas_upload_snapshot(const Ref<Image> &p_img, const Ref<Image> &p_live) {
+	if (p_img == p_live) {
+		return p_img->duplicate();
+	}
+	return p_img;
+}
