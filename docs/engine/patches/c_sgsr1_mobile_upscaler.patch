diff --git a/servers/rendering/renderer_rd/effects/sgsr.cpp b/servers/rendering/renderer_rd/effects/sgsr.cpp
new file mode 100644
index 0000000..b301d61
--- /dev/null
+++ b/servers/rendering/renderer_rd/effects/sgsr.cpp
@@ -0,0 +1,64 @@
+/**************************************************************************/
+/*  sgsr.cpp                                                              */
+/**************************************************************************/
+/*  Coronado patch c: Snapdragon Game Super Resolution 1 as the spatial   */
+/*  upscaler of renderers without compute post-processing (Mobile).       */
+/**************************************************************************/
+
+#include "sgsr.h"
+
+#include "servers/rendering/renderer_rd/framebuffer_cache_rd.h"
+#include "servers/rendering/renderer_rd/storage_rd/material_storage.h"
+#include "servers/rendering/renderer_rd/uniform_set_cache_rd.h"
+
+using namespace RendererRD;
+
+SGSR::SGSR() {
+	Vector<String> modes;
+	// Edge direction on: smoother diagonal edges than the plain mode for a small extra cost on edge pixels
+	// (the plain mode re-sharpened FXAA's steps into wobbly lines in the test scene).
+	modes.push_back("\n#define USE_EDGE_DIRECTION\n");
+	sgsr_shader.initialize(modes);
+	shader_version = sgsr_shader.version_create();
+	pipeline.setup(sgsr_shader.version_get_shader(shader_version, 0), RD::RENDER_PRIMITIVE_TRIANGLES, RD::PipelineRasterizationState(), RD::PipelineMultisampleState(), RD::PipelineDepthStencilState(), RD::PipelineColorBlendState::create_disabled(), 0);
+}
+
+SGSR::~SGSR() {
+	pipeline.clear();
+	sgsr_shader.version_free(shader_version);
+}
+
+void SGSR::process(Ref<RenderSceneBuffersRD> p_render_buffers, RID p_source_rd_texture, RID p_destination_texture) {
+	UniformSetCacheRD *uniform_set_cache = UniformSetCacheRD::get_singleton();
+	ERR_FAIL_NULL(uniform_set_cache);
+	MaterialStorage *material_storage = MaterialStorage::get_singleton();
+	ERR_FAIL_NULL(material_storage);
+
+	Size2i internal_size = p_render_buffers->get_internal_size();
+
+	SGSRPushConstant push_constant;
+	memset(&push_constant, 0, sizeof(SGSRPushConstant));
+	push_constant.viewport_info[0] = 1.0f / float(internal_size.width);
+	push_constant.viewport_info[1] = 1.0f / float(internal_size.height);
+	push_constant.viewport_info[2] = float(internal_size.width);
+	push_constant.viewport_info[3] = float(internal_size.height);
+	// "rendering/scaling_3d/fsr_sharpness": 0.0 is sharpest, 2.0 least sharp, default 0.2.
+	// SGSR's edge sharpness: 1.0 to 2.25, higher is sharper, 2.0 is its default.
+	push_constant.edge_sharpness = CLAMP(2.1f - 0.5f * p_render_buffers->get_fsr_sharpness(), 1.0f, 2.25f);
+	push_constant.edge_threshold = 8.0f / 255.0f;
+
+	RID shader = sgsr_shader.version_get_shader(shader_version, 0);
+	ERR_FAIL_COND(shader.is_null());
+
+	RID default_sampler = material_storage->sampler_rd_get_default(RSE::CANVAS_ITEM_TEXTURE_FILTER_LINEAR, RSE::CANVAS_ITEM_TEXTURE_REPEAT_DISABLED);
+	RD::Uniform u_source_rd_texture(RD::UNIFORM_TYPE_SAMPLER_WITH_TEXTURE, 0, { default_sampler, p_source_rd_texture });
+
+	RID dest_framebuffer = FramebufferCacheRD::get_singleton()->get_cache(p_destination_texture);
+
+	RD::DrawListID draw_list = RD::get_singleton()->draw_list_begin(dest_framebuffer);
+	RD::get_singleton()->draw_list_bind_render_pipeline(draw_list, pipeline.get_render_pipeline(RD::INVALID_ID, RD::get_singleton()->framebuffer_get_format(dest_framebuffer), false, RD::get_singleton()->draw_list_get_current_pass()));
+	RD::get_singleton()->draw_list_bind_uniform_set(draw_list, uniform_set_cache->get_cache(shader, 0, u_source_rd_texture), 0);
+	RD::get_singleton()->draw_list_set_push_constant(draw_list, &push_constant, sizeof(SGSRPushConstant));
+	RD::get_singleton()->draw_list_draw(draw_list, false, 1u, 3u);
+	RD::get_singleton()->draw_list_end();
+}
diff --git a/servers/rendering/renderer_rd/effects/sgsr.h b/servers/rendering/renderer_rd/effects/sgsr.h
new file mode 100644
index 0000000..74e5007
--- /dev/null
+++ b/servers/rendering/renderer_rd/effects/sgsr.h
@@ -0,0 +1,40 @@
+/**************************************************************************/
+/*  sgsr.h                                                                */
+/**************************************************************************/
+/*  Coronado patch c: Snapdragon Game Super Resolution 1 as the spatial   */
+/*  upscaler of renderers without compute post-processing (Mobile).       */
+/*  Shader: BSD-3-Clause, Qualcomm Innovation Center, Inc.                */
+/**************************************************************************/
+
+#pragma once
+
+#include "servers/rendering/renderer_rd/effects/spatial_upscaler.h"
+#include "servers/rendering/renderer_rd/pipeline_cache_rd.h"
+#include "servers/rendering/renderer_rd/shaders/effects/sgsr_upscale.glsl.gen.h"
+#include "servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h"
+
+namespace RendererRD {
+
+class SGSR : public SpatialUpscaler {
+public:
+	SGSR();
+	~SGSR();
+
+	virtual const Span<char> get_label() const final { return "SGSR 1 Upscale"; }
+	virtual void ensure_context(Ref<RenderSceneBuffersRD> p_render_buffers) final {}
+	virtual void process(Ref<RenderSceneBuffersRD> p_render_buffers, RID p_source_rd_texture, RID p_destination_texture) final;
+
+private:
+	struct SGSRPushConstant {
+		float viewport_info[4]; // xy = 1.0 / source size, zw = source size.
+		float edge_sharpness;
+		float edge_threshold;
+		float pad[2];
+	};
+
+	SgsrUpscaleShaderRD sgsr_shader;
+	RID shader_version;
+	PipelineCacheRD pipeline;
+};
+
+} // namespace RendererRD
