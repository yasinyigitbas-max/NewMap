; Coronado city kit: the new map, separated from the game repo (coronado-source) on 18 Nov so sessions start fast.
; A standalone Godot 4.7.2 project: builds the pieces, previews them, runs the checks. The game imports the finished
; map at integration (see CLAUDE.md).
config_version=5

[application]

config/quit_on_go_back=false
config/name="Coronado City Kit"
run/main_scene="res://tools/city/rig/rig.tscn"

[rendering]
renderer/rendering_method="mobile"
; B28 (Yasin, 20 Nov: "moving draws into its own thread? it won big in the old build"): the separate render thread
driver/threads/thread_model=2
textures/vram_compression/import_etc2_astc=true
; the game engine's own light grid (docs/engine, patch e): 32 omni + 32 spot lights for a fixed cost. A stock engine ignores it.
lights_and_shadows/mobile_light_grid=true
; per-building shader values (rt_bldg: tint, wear, lit windows, tier pivot / window = 5 slots a building): the default
; 65,536 slots overflowed on the phone's 210 km/h drive and the app froze (20 Nov, review/phone/crash_20nov_0314).
; 262,144 slots = 4 MB of graphics memory.
limits/global_shader_variables/buffer_size=262144

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_speech/plugin.cfg")

[audio]
; B22 (Yasin 20 Nov: back taps "USED MIC INPUT (SOUND OF TAP) ACCELEROMETER AND GYRO"): the microphone gives nothing unless
; audio input is on (the old game had it on). The mic only confirms a softer tap; a hard one counts on motion alone.
driver/enable_input=true

[input_devices]
; B20 (Yasin 20 Nov: "swaying phone fast downwards doesnt put us into the combat mode"): since Godot 4.3 the phone's motion
; sensors are OFF unless enabled here, and Input.get_accelerometer() / get_gyroscope() read zero (CityPlayer::sense took
; that for a PC). The swing into combat and the tap-to-punch need both.
sensors/enable_accelerometer=true
sensors/enable_gyroscope=true

[physics]
; the phone test rig runs the game's physics setup (Jolt on its own thread); the PC tools keep the default engine
3d/physics_engine.android="Jolt Physics"
3d/run_on_separate_thread.android=true
; (28 Nov night) at most 4 physics steps a drawn frame on the phone (Godot's default 8): a frame that ran long was
; followed by up to 8 steps of the new bodies' physics, which made the next frame long too (a spiral seen on the Redmi:
; 133 ms frames, 8 steps each). With 4, a slow moment slows the game a little instead of locking it there.
common/max_physics_steps_per_frame.android=4
; (28 Nov, Yasin: "car camera jitter still there, and now character himself moves extremely jittery") the physics steps
; (60 a second) and the drawn frames do not line up: what physics moves is drawn between its last two steps. On only for
; him, the people's bodies and the car he drives (CityPlayer::_ready turns the root off); the camera follows the drawn places.
common/physics_interpolation=true

[shader_globals]
; city kit runtime shaders (map_dc/coronado/city_kit/shaders/rt): the game drives these (day cycle, weather)
refl_env={
"type": "vec2",
"value": Vector2(1, 0)
}
ck_night={
"type": "float",
"value": 0.0
}
ck_wind_strength={
"type": "float",
"value": 1.0
}
ck_wind_dir={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
ck_look_contact={
"type": "float",
"value": 1.0
}
ck_look_windows={
"type": "float",
"value": 1.0
}
ck_look_glass={
"type": "float",
"value": 1.0
}
ck_look_sky_top={
"type": "color",
"value": Color(0.32, 0.52, 0.82, 1)
}
ck_look_sky_horizon={
"type": "color",
"value": Color(0.72, 0.8, 0.88, 1)
}
ck_look_propmaps={
"type": "float",
"value": 1.0
}
ck_look_detail={
"type": "float",
"value": 1.0
}
ck_look_detail_tex={
"type": "sampler2D",
"value": "res://map_dc/coronado/city_kit/look/detail_wall.png"
}
ck_look_between={
"type": "float",
"value": 1.0
}
ck_look_signs={
"type": "float",
"value": 1.0
}
ck_cells_loaded={
"type": "sampler2D",
"value": ""
}
ck_signal_grid={
"type": "vec3",
"value": Vector3(100, 100, 200)
}
ck_signal_time={
"type": "float",
"value": -1.0
}
ck_tier_band={
"type": "float",
"value": 0.0
}
