/android/
/OUT/

# the native module (traffic and people in C++): built by native/build.sh. The libraries, the objects and the
# .gdextension file Godot reads stay out of git, so a checkout that has not built it never loads it
/native/bin/
/native/build/
/native/coronado_city.gdextension
/native/coronado_city.gdextension.uid

# Mixamo downloads: the source of characters/rocketbox/clips_mx_*.res (tools/people/make_mixamo.gd); 218 MB, kept out of git
characters/mixamo/*.fbx
characters/mixamo2/*.fbx
characters/mixamo2/*.import
characters/ylib/*.fbx
characters/ylib/*.import
