extends "res://map_dc/coronado/city_kit/interiors/room_contracts.gd"
## Room contracts for the residential zone's buildings (19 Nov; Yasin: "prop in the glass" - a meter hung over a window).
## The shared room_contracts.gd measures only the models the locked samples use; the residential variants place ~30
## house, garage and shop models it never saw. This runs the SAME measurement (its _contract, unchanged) for every model
## the variants can place (rv_designs.gd + the corner shops) that the shared file lacks, and writes them to
## interiors/room_contracts_res.json. room_contracts.json is not touched. Read by rv_lib.gd (wall items keep clear of
## windows and doors) and by tools/city/pilot/check_life.gd (rule "glass").
##   godot --headless --path . -s res://map_dc/coronado/city_kit/interiors/room_contracts_res.gd
const D := preload("res://tools/city/pilot/pieces/rv_designs.gd")

func _run() -> void:
	var L: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://assets/coronado_kit/textures/city_layout.json"))
	for r: String in L.regions:
		var e: Dictionary = L.regions[r]
		if r.begins_with("O_") and e.has("uv"): regs[r] = e.uv
	var have: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(OUT + "room_contracts.json")).models
	var want := {}
	for des: Dictionary in [D.V1, D.V2, D.V3, D.V4]:
		for k: String in ["houses", "garages", "d_houses"]:
			for f: String in des.get(k, []): want[f] = true
	for f2: String in ["commercial/com_shallow_books", "commercial/com_shallow_cafe", "commercial/com_surf_shop", "commercial/com_realty", "commercial/com_bakery"]: want[f2] = true
	var models := {}
	for f3: String in want:
		if have.has(f3): continue
		models[f3] = _contract(f3)
	_save("room_contracts_res.json", {"_doc": "Generated by room_contracts_res.gd (the shared room_contracts.gd measurement) for the residential variants' models that room_contracts.json lacks. Same format.", "models": models})
	print("RCRES models=%d" % models.size())
	quit()
