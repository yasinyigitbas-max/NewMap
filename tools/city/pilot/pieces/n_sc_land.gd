static func at(u: float, v: float) -> float:
	for k: String in P:
		var p: Array = P[k]
		var nu: int = p[2]; var nv: int = p[3]
		if u < float(p[0]) or v < float(p[1]) or u > float(p[0]) + STEP * (nu - 1) or v > float(p[1]) + STEP * (nv - 1): continue
		var h: Array = p[4]
		var fx := clampf((u - float(p[0])) / STEP, 0.0, nu - 1.001); var fz := clampf((v - float(p[1])) / STEP, 0.0, nv - 1.001)
		var i := int(fx); var j := int(fz); var a := fx - i; var b := fz - j
		var h00: float = h[j * nu + i]; var h10: float = h[j * nu + i + 1]; var h01: float = h[(j + 1) * nu + i]; var h11: float = h[(j + 1) * nu + i + 1]
		return lerpf(lerpf(h00, h10, a), lerpf(h01, h11, a), b)
	push_error("n_sc_land: (%.1f, %.1f) outside every patch" % [u, v])
