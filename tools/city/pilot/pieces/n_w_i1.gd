func _init() -> void: _run.call_deferred()

func _run() -> void:
	var c := L.new("n_w_i1", 2.15)
	var W := 91.0; var D := 172.0
	var land := func(x: float, z: float) -> float: return L.land_at(LAND, x, z) + 0.08
	var base := L.edged(land, W, D, EDGE_N, EDGE_S, EDGE_W, EDGE_E, 8.0)
	var SITES := [["industrial/ind_factory", Vector2(45.0, 8.0), "n", "boatworks"], ["industrial/ind_repair", Vector2(66.0, 124.0), "s", "marine_engines"],
		["industrial/ind_warehouse", Vector2(25.0, 134.0), "s", "marine_supply"]]
	var pads: Array = []
	for st: Array in SITES:
		var r0: Array = L.bld_rect(String(st[0]), st[1], String(st[2]))
		pads.append([maxf(0.0, float(r0[0]) - 0.3), maxf(0.0, float(r0[1]) - 0.3), minf(W, float(r0[2]) + 0.3), minf(D, float(r0[3]) + 0.3)])
	var gl := L.grid_lots(0.0, 0.0, W, D, pads, base)
	c.terrain(gl.lots)
	c.skirt_depth = 0.4
	# ---- surfaces (first paint wins)
	c.paint("concrete", 20.0, 0.0, 70.0, 8.0)               # the boatworks' frontage walk
	c.paint("grass", 0.0, 0.0, 20.0, 40.0)                  # planted corner by the north street
	c.paint("asphalt", 64.0, 8.0, 91.0, 37.0)               # staff parking
	c.paint("grass", 64.0, 0.0, 91.0, 8.0)                  # planted strip between the staff lot and the street
	c.paint("asphalt", 80.0, 37.0, 88.0, 134.0)             # the lane from the staff lot down to the drive
	c.paint("gravel", 0.0, 40.0, 78.0, 102.0)               # the storage yard
	c.paint("asphalt", 37.0, 104.0, 57.0, 124.0)            # customer pocket between the warehouse and the repair shop
	c.paint("asphalt", 37.0, 124.0, 91.0, 134.0)            # the drive from the east apron
	c.paint("asphalt", 0.0, 134.0, 91.0, 172.0)             # the south yard: loading and customer parking
	c.paint("grass", 0.0, 0.0, W, D)                        # the rest: rough grass
	c.build_floor(L.rect_edges(0.0, 0.0, W, D))
	if c.stage == "ground": c.finish(); quit(); return
	var B := {}
	for k in SITES.size():
		c.y0 = float(gl.pads[k][4])
		B[String(SITES[k][3])] = c.bld(String(SITES[k][0]), SITES[k][1], String(SITES[k][2]), false, String(SITES[k][3]))
	c.y0 = 2.15
	var BW: Dictionary = B.boatworks; var ME: Dictionary = B.marine_engines; var MS: Dictionary = B.marine_supply
	# ---- the boatworks' frontage: planters, a bench for the smokers, the bike rack, lamps
	for pl: float in [24.0, 36.0, 54.0, 66.0]: c.put("plant_potted_succulent", "normal", c.gp(pl, 6.6), 0.0, "boatworks: planters along its frontage")
	c.put("prop_bike_rack", "worn", c.gp(68.0, 5.0), 0.0, "boatworks: staff bikes by the side door")
	c.put("prop_park_bench", "worn", c.gp(21.5, 5.0), 90.0, "boatworks: the smokers' bench, facing along the frontage")
	c.put("prop_trash_receptacle", "worn", c.gp(21.5, 7.4), 0.0, "boatworks: a bin by the bench, against the planter")
	for lm: float in [20.0, 70.0]: c.put("prop_lamp_cobra", "worn", c.gp(lm, 1.0), 0.0, "frontage: lit at night")
	c.put("prop_usps_collection_box", "worn", c.gp(44.0, 1.0), 180.0, "frontage: the mailbox for the yard's offices")
	# ---- staff parking: two rows, an aisle, light, marks
	var sx := 66.4
	while sx < 89.0:
		c.stalls.append([sx, 11.0, 0.0, c.yf(sx, 11.0)]); c.stalls.append([sx, 33.0, 180.0, c.yf(sx, 33.0)])
		sx += 2.7
	for ws: float in [66.4, 71.8, 77.2, 82.6, 88.0]: c.put("prop_wheel_stop_concrete", "worn", c.gp(ws, 8.9), 0.0, "staff lot: wheel stops at the stall heads")
	c.put("prop_lot_light_pole", "worn", c.gp(77.0, 22.0), 0.0, "staff lot: light in the aisle's middle")
	c.oil(Vector2(71.8, 11.0), 0.0); c.oil(Vector2(82.6, 33.0), 0.0); c.cracks(64.0, 8.0, 91.0, 37.0, 6, 0.4)
	# ---- the storage yard: chain-link round it, a rolling gate from the lane
	c.ring_fence("chainlink", [Vector2(0.6, 40.0), Vector2(78.0, 40.0), Vector2(78.0, 102.0), Vector2(0.6, 102.0)], 1, 32.0, 5.8, "fence_gate_rolling_chainlink", "storage yard: chain-link round it")
	for k in 4: c.put(["prop_container_20ft_blue", "prop_container_20ft_red", "prop_container_20ft_white", "prop_container_20ft_green"][k], "worn", c.gp(5.0, 48.0 + k * 7.5), 0.0, "storage yard: containers of boat parts along the west fence")
	for k in 3: c.put("prop_boat_trailer", "worn", c.gp(18.0 + k * 6.5, 60.0), 0.0, "storage yard: boats on trailers waiting for the boatworks")
	c.put("prop_boat_skiff", "worn", c.gp(41.0, 60.0), 0.0, "storage yard: a skiff on blocks")
	c.put("prop_dumpster_rolloff_20yd", "worn", c.gp(60.0, 48.0), 0.0, "storage yard: the roll-off for the boatworks' scrap")
	for kr in 4: c.put("prop_k_rail", "worn", c.gp(20.0 + kr * 4.0, 97.0), 0.0, "storage yard: k-rails stacked out of the way along the south fence")
	c.put("prop_tank_horizontal_propane", "worn", c.gp(50.0, 43.0), 0.0, "storage yard: propane for the boatworks' heaters, behind the factory")
	c.put("prop_switch_rack", "worn", c.gp(68.0, 44.0), 0.0, "storage yard: the electrical service to the factory, on the gravel")
	for dr: Array in [[30.0, 80.0], [31.0, 81.2], [32.2, 80.3]]: c.put("prop_channelizer_drum", "worn", c.gp(float(dr[0]), float(dr[1])), 0.0, "storage yard: drums of old paint")
	c.put("prop_lot_light_pole", "worn", c.gp(40.0, 75.0), 0.0, "storage yard: lit for night shifts")
	c.tyre(Vector2(74.0, 72.0), 90.0, 6.0, 0.4); c.tyre(Vector2(50.0, 85.0), 30.0, 5.0, 0.35)
	# ---- the lane and the drive
	c.put("prop_sign_no_parking", "worn", c.gp(79.4, 60.0), 0.0, "lane: keep clear for the yard gate")
	c.put("prop_sign_stop", "worn", c.gp(89.6, 134.6), 90.0, "drive: stop before the walk and the east street")
	c.tyre(Vector2(88.0, 129.0), -80.0, 6.0, 0.45); c.tyre(Vector2(84.0, 126.0), 45.0, 5.0, 0.4); c.cracks(37.0, 124.0, 91.0, 134.0, 6, 0.4)
	# ---- the customer pocket between the warehouse and the repair shop
	var cz := 106.4
	while cz < 122.5:
		c.stalls.append([47.0, cz, 90.0, c.yf(47.0, cz)]); cz += 2.7
	c.put("prop_bike_rack", "worn", c.gp(54.0, 106.0), 90.0, "repair shop: bikes by its side")
	c.put("prop_vending_soda", "worn", c.gp(55.6, 118.0), -90.0, "repair shop: drinks against its west wall for the waiting customers")
	# ---- the south yard: warehouse loading, customer rows, lights, the dumpsters against the warehouse wall
	var lx := 60.0
	while lx < 89.0:
		c.stalls.append([lx, 140.0, 180.0, c.yf(lx, 140.0)]); c.stalls.append([lx, 166.0, 0.0, c.yf(lx, 166.0)])
		lx += 2.7
	c.put("prop_lot_light_pole", "worn", c.gp(74.0, 153.0), 0.0, "south yard: light over the customer rows")
	c.put("prop_lot_light_pole", "worn", c.gp(25.0, 160.0), 0.0, "south yard: light over the loading apron")
	c.put("prop_dumpster_3yd_green", "worn", c.gp(38.4, 112.0), 90.0, "warehouse: waste against its east wall")
	c.put("prop_dumpster_3yd_blue", "worn", c.gp(38.4, 115.6), 90.0, "warehouse: cardboard against its east wall")
	for tm: Array in [[15.0, 168.0, 10.0], [44.0, 168.0, -10.0], [25.0, 146.0, 90.0], [20.0, 140.0, 0.0]]: c.tyre(Vector2(float(tm[0]), float(tm[1])), float(tm[2]), 7.0, 0.5)
	for ol: Array in [[25.0, 140.0], [18.0, 142.0], [65.4, 166.0], [76.2, 140.0]]: c.oil(Vector2(float(ol[0]), float(ol[1])), 0.0)
	c.cracks(0.0, 134.0, 91.0, 172.0, 14, 0.45)
	c.put("prop_bollard_steel", "worn", c.gp(12.0, 135.0), 0.0, "warehouse: a bollard guarding the door frame from trucks")
	c.put("prop_bollard_steel", "worn", c.gp(38.0, 135.0), 0.0, "warehouse: a bollard guarding the corner from trucks")
	# ---- service sides, roofs, door grime
	for r: Dictionary in [BW, ME, MS]: c.services(r, 2.0, 1, false)
	for r3: Dictionary in [BW, ME, MS]:
		for dr2: Array in r3.doors:
			var q: Vector3 = dr2[1]; var o: Vector3 = dr2[2]
			c.grime(Vector2(q.x + o.x * 0.9, q.z + o.z * 0.9), 0.0, 1.8, 1.6, 0.5)
	c.finish()
	quit()
