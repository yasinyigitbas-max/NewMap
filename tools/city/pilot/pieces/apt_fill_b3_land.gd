const U0 := 9.2
const U1 := 240.8
const V0 := 9.2
const V1 := 100.0

static func _t(t: Array, x: float) -> float:
	if x <= float(t[0][0]): return float(t[0][1])
	for i in t.size() - 1:
		var a: Array = t[i]; var b: Array = t[i + 1]
		if x <= float(b[0]): return lerpf(float(a[1]), float(b[1]), (x - float(a[0])) / (float(b[0]) - float(a[0])))
	return float(t[t.size() - 1][1])

static func north(u: float) -> float: return L2._lerp_table(L2.SIXTH, u) - 8.0
static func west(v: float) -> float: return _t(BAVE, v)
static func east(v: float) -> float: return _t(ADELA, v)
static func south(u: float) -> float: return _t(SOUTH, u)
static func res(u: float) -> float: return _t(RES, u)

static func surface(x: float, z: float) -> float:
	var s := clampf((x - U0) / (U1 - U0), 0.0, 1.0); var t := clampf((z - V0) / (V1 - V0), 0.0, 1.0)
	var c := (1.0 - t) * north(x) + t * south(x) + (1.0 - s) * west(z) + s * east(z)
	c -= (1.0 - s) * (1.0 - t) * north(U0) + s * (1.0 - t) * north(U1) + (1.0 - s) * t * south(U0) + s * t * south(U1)
	return c

## the retaining faces on the shared line with the residential quarters, u0..u1: [x0, z0, x1, z1, y_low, y_high, side]
## per metre where the two grounds differ by more than 2 cm; 2 cm inside this block; facing north (this block) where
## theirs is higher, south (their yards) where this block is higher; 5 cm into the lower ground
static func seam_faces(u0: float, u1: float) -> Array:
	var out: Array = []
	var u := u0
	while u < u1 - 0.01:
		var ue := minf(u + 1.0, u1)
		var m := (u + ue) * 0.5
		var mine := south(m); var theirs := res(m)
		if absf(mine - theirs) > 0.02:
			out.append([u, V1 - 0.02, ue, V1 - 0.02, minf(mine, theirs) - 0.05, maxf(mine, theirs), 1.0 if theirs > mine else -1.0])
		u = ue
	return out
