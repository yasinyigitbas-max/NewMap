func _init() -> void: _run.call_deferred()

func _run() -> void:
	var c := L.new("n_w_i2", 2.15)
	var W := 91.0; var D := 172.0
	var land := func(x: float, z: float) -> float: return L.land_at(LAND, x, z) + 0.08
	var base := L.edged(land, W, D, EDGE_N, EDGE_S, EDGE_W, EDGE_E, 8.0)
	c.hfn = base
	var SITES := [["industrial/ind_warehouse", Vector2(66.0, 4.0), "n", "building_supply"], ["industrial/ind_repair", Vector2(50.0, 150.0), "s", "tire_brake"],
		["commercial/com_orange_corner", Vector2(32.0, 166.0), "s", "liquor_deli"]]
	var pads: Array = []
	for st: Array in SITES:
		var r0: Array = L.bld_rect(String(st[0]), st[1], String(st[2]))
		pads.append([maxf(0.0, float(r0[0]) - 0.3), maxf(0.0, float(r0[1]) - 0.3), minf(W, float(r0[2]) + 0.3), minf(D, float(r0[3]) + 0.3)])
	var gl := L.grid_lots(0.0, 0.0, W, D, pads, base)
	c.terrain(gl.lots)
	c.skirt_depth = 0.5
	# ---- surfaces (first paint wins)
	c.paint("gravel", 0.0, 0.0, 48.0, 70.0)                 # the builders' yard
	c.paint("concrete", 50.0, 0.0, 91.0, 4.0)               # the building supply's frontage
	c.paint("asphalt", 50.0, 33.0, 91.0, 58.0)              # its customer lot (east apron z 39..46.5)
	c.paint("gravel", 0.0, 72.0, 91.0, 120.0)               # RV and boat storage
	c.paint("asphalt", 60.0, 122.0, 91.0, 132.0)            # the lane from the east apron to the storage gate
	c.paint("asphalt", 38.0, 150.0, 91.0, 172.0)            # tire & brake forecourt (south apron x 50..59.5)
	c.paint("asphalt", 0.0, 140.0, 25.0, 172.0)             # the liquor store's side lot (south apron x 15..24.5)
	c.paint("concrete", 25.0, 166.0, 38.0, 172.0)           # the store's walk to the street
	c.paint("grass", 0.0, 0.0, W, D)                        # the rest: rough, dry grass
	c.build_floor(L.rect_edges(0.0, 0.0, W, D))
	if c.stage == "ground": c.finish(); quit(); return
	var B := {}
	for k in SITES.size():
		c.y0 = float(gl.pads[k][4])
		B[String(SITES[k][3])] = c.bld(String(SITES[k][0]), SITES[k][1], String(SITES[k][2]), false, String(SITES[k][3]))
	var BS: Dictionary = B.building_supply; var TB: Dictionary = B.tire_brake; var LD: Dictionary = B.liquor_deli
	# ---- the builders' yard: chain-link, rolling gate on the north apron, materials, roll-offs, the site office container
	c.ring_fence("chainlink", [Vector2(0.6, 0.8), Vector2(48.0, 0.8), Vector2(48.0, 70.0), Vector2(0.6, 70.0)], 0, 37.75, 5.8, "fence_gate_rolling_chainlink", "builders' yard: chain-link round it")
	c.put("prop_container_20ft_white", "worn", c.gp(6.0, 12.0), 0.0, "builders' yard: the site office in a container by the gate")
	c.put("prop_container_20ft_blue", "worn", c.gp(6.0, 22.0), 0.0, "builders' yard: tool store")
	for kr in 5: c.put("prop_k_rail", "worn", c.gp(14.0 + kr * 4.2, 64.0), 0.0, "builders' yard: k-rails waiting for the next road job")
	for tf in 4: c.put("fence_temp_fence_panel", "worn", c.gp(14.0, 40.0 + tf * 0.4), 0.0, "builders' yard: temporary fence panels stacked", false)
	for cn: Array in [[20.0, 50.0], [20.6, 50.4], [21.2, 50.0], [22.0, 50.6]]: c.put("prop_cone_28in", "worn", c.gp(float(cn[0]), float(cn[1])), 0.0, "builders' yard: cones")
	for br: Array in [[28.0, 50.0], [28.0, 53.0]]: c.put("prop_barricade_type3", "worn", c.gp(float(br[0]), float(br[1])), 0.0, "builders' yard: barricades for road closures")
	for dr: Array in [[42.0, 60.0], [43.2, 60.4], [42.6, 61.4]]: c.put("prop_channelizer_drum", "worn", c.gp(float(dr[0]), float(dr[1])), 0.0, "builders' yard: drums")
	c.put("prop_lot_light_pole", "worn", c.gp(24.0, 36.0), 0.0, "builders' yard: lit at night")
	c.tyre(Vector2(37.75, 6.0), 0.0, 7.0, 0.5); c.tyre(Vector2(30.0, 20.0), 40.0, 6.0, 0.4)
	# ---- Pacific Building Supply: frontage, the customer lot, the loading dock's dumpsters against the wall
	for pl: float in [56.0, 76.0]: c.put("plant_potted_succulent", "normal", c.gp(pl, 3.2), 0.0, "building supply: planters at the doors")
	c.put("prop_newspaper_box_blue", "worn", c.gp(51.0, 1.0), 180.0, "building supply: papers for the early contractors")
	var sx := 55.0
	while sx < 89.0:
		c.stalls.append([sx, 36.5, 180.0, c.yf(sx, 36.5)]); c.stalls.append([sx, 54.5, 0.0, c.yf(sx, 54.5)])
		sx += 2.7
	c.put("prop_lot_light_pole", "worn", c.gp(72.0, 45.0), 0.0, "customer lot: light in the aisle")
	c.put("prop_dumpster_3yd_green", "worn", c.gp(52.8, 26.0), 90.0, "building supply: waste against its west wall")
	c.tyre(Vector2(88.0, 43.0), -80.0, 6.0, 0.45); c.oil(Vector2(60.4, 36.5), 0.0); c.oil(Vector2(71.2, 54.5), 0.0); c.cracks(50.0, 33.0, 91.0, 58.0, 8, 0.4)
	# ---- RV and boat storage: chain-link, gate off the lane, trailers in rows, containers as storage units
	c.ring_fence("chainlink", [Vector2(0.6, 72.0), Vector2(90.4, 72.0), Vector2(90.4, 120.0), Vector2(0.6, 120.0)], 2, 15.4, 5.8, "fence_gate_rolling_chainlink", "storage: chain-link round it")
	for row in 2:
		for k in 6:
			c.put("prop_boat_trailer", "worn", c.gp(8.0 + k * 7.0, 80.0 + row * 12.0), 0.0, "storage: boats on trailers in rows, an aisle between")
	for k in 5: c.put(["prop_container_20ft_red", "prop_container_20ft_green", "prop_container_20ft_blue", "prop_container_20ft_white", "prop_container_20ft_red"][k], "worn", c.gp(54.0 + k * 7.0, 108.0), 0.0, "storage: containers rented as storage units")
	c.put("prop_boat_skiff", "worn", c.gp(60.0, 86.0), 90.0, "storage: a skiff on blocks")
	c.put("prop_lot_light_pole", "worn", c.gp(45.0, 96.0), 0.0, "storage: lit at night")
	c.put("prop_sign_no_parking", "worn", c.gp(78.0, 121.2), 0.0, "storage: keep the gate clear")
	c.tyre(Vector2(88.0, 127.0), -80.0, 6.0, 0.45); c.tyre(Vector2(76.0, 124.0), 20.0, 5.0, 0.4)
	# ---- Strand Tire & Brake: forecourt, waiting bench, the drinks machine against its wall, oil and marks
	c.put("prop_vending_soda", "worn", c.gp(60.6, 145.0), -90.0, "tire & brake: drinks against its east wall")
	var fx := 68.0
	while fx < 89.0:
		c.stalls.append([fx, 160.0, 90.0, c.yf(fx, 160.0)]); fx += 2.7
	for ol: Array in [[44.0, 156.0], [52.0, 158.0], [56.0, 155.0]]: c.oil(Vector2(float(ol[0]), float(ol[1])), 0.0)
	c.tyre(Vector2(55.0, 168.0), 0.0, 7.0, 0.5); c.tyre(Vector2(46.0, 156.0), 30.0, 5.0, 0.45); c.cracks(38.0, 150.0, 91.0, 172.0, 10, 0.5)
	c.put("prop_dumpster_3yd_green", "worn", c.gp(39.8, 140.0), 90.0, "tire & brake: waste against its west wall")
	# ---- Strand Liquor & Deli: papers, the ice chest, a bench, a lost shopping cart, its side lot
	c.put("prop_ice_chest", "worn", c.gp(24.4, 160.0), 90.0, "liquor & deli: the ice chest against its west wall")
	c.put("prop_newspaper_box_red", "worn", c.gp(39.0, 168.0), 0.0, "liquor & deli: papers by the door")
	c.put("prop_trash_receptacle", "worn", c.gp(24.6, 164.0), 0.0, "liquor & deli: a bin against its corner")
	c.put("prop_shopping_cart", "worn", c.gp(8.0, 146.0), 37.0, "liquor & deli: a shopping cart left in the side lot")
	var ly := 144.0
	while ly < 165.0:
		c.stalls.append([6.0, ly, 90.0, c.yf(6.0, ly)]); ly += 2.7
	c.oil(Vector2(6.0, 149.4), 90.0); c.tyre(Vector2(20.0, 168.0), 10.0, 6.0, 0.45); c.cracks(0.0, 140.0, 25.0, 172.0, 6, 0.55)
	# ---- the block wall on the gritty side (tagged), from the storage fence's corner to the street
	c.cmu(Vector2(0.6, 120.6), Vector2(0.6, 171.4), "gritty side: a block wall closing the lots from the storage fence to the street, tagged")
	# ---- service sides, door grime
	for r: Dictionary in [BS, TB, LD]: c.services(r, 2.0, 1, false)
	for r3: Dictionary in [BS, TB, LD]:
		for dr2: Array in r3.doors:
			var q: Vector3 = dr2[1]; var o: Vector3 = dr2[2]
			c.grime(Vector2(q.x + o.x * 0.9, q.z + o.z * 0.9), 0.0, 1.8, 1.6, 0.55)
	c.finish()
	quit()
