static var _wh := {}
static var _sh := {}
static var _gc := {}

static func _hash(segs: PackedFloat32Array, stride: int, ui: int, vi: int, uj: int, vj: int, reach: float) -> Dictionary:
	var h := {}
	for s in segs.size() / stride:
		var o := s * stride
		var a0 := minf(segs[o + ui], segs[o + uj]) - reach; var a1 := maxf(segs[o + ui], segs[o + uj]) + reach
		var b0 := minf(segs[o + vi], segs[o + vj]) - reach; var b1 := maxf(segs[o + vi], segs[o + vj]) + reach
		for cx in range(floori(a0 / HC), floori(a1 / HC) + 1):
			for cz in range(floori(b0 / HC), floori(b1 / HC) + 1):
				var k := Vector2i(cx, cz)
				var arr: PackedInt32Array = h.get(k, PackedInt32Array())
				arr.append(s); h[k] = arr        # (a packed array is a value: written back)
	return h

static var _W := PackedFloat32Array()
static var _S := PackedFloat32Array()
static func _init_data() -> void:
	if not _W.is_empty(): return
	_W = PackedFloat32Array(WALK)
	_wh = _hash(_W, 6, 0, 1, 3, 4, EASE)
	var s := PackedFloat32Array()
	for i in SHORE.size() / 2 - 1: s.append_array([SHORE[i * 2], SHORE[i * 2 + 1], SHORE[i * 2 + 2], SHORE[i * 2 + 3]])
	_S = s
	_sh = _hash(_S, 4, 0, 1, 2, 3, SHORE_EASE)

## the nearest street walk edge within EASE: [distance, walk height at the foot, foot u, foot v] (distance INF if none)
static func walk_foot(u: float, v: float) -> Array:
	_init_data()
	var best := [INF, 0.0, 0.0, 0.0]
	var k := Vector2i(floori(u / HC), floori(v / HC))
	if not _wh.has(k): return best
	var p := Vector2(u, v)
	for s: int in _wh[k]:
		var o := s * 6
		var a := Vector2(_W[o], _W[o + 1]); var b := Vector2(_W[o + 3], _W[o + 4])
		var t := clampf((p - a).dot(b - a) / maxf((b - a).length_squared(), 1e-9), 0.0, 1.0)
		var f := a + (b - a) * t
		var d := p.distance_to(f)
		if d < best[0]: best = [d, lerpf(_W[o + 2], _W[o + 5], t), f.x, f.y]
	return best

## distance to the 0 m line (capped at SHORE_EASE)
static func shore_d(u: float, v: float) -> float:
	_init_data()
	var k := Vector2i(floori(u / HC), floori(v / HC))
	if not _sh.has(k): return SHORE_EASE
	var p := Vector2(u, v); var best := SHORE_EASE
	for s: int in _sh[k]:
		var o := s * 4
		var a := Vector2(_S[o], _S[o + 1]); var b := Vector2(_S[o + 2], _S[o + 3])
		var t := clampf((p - a).dot(b - a) / maxf((b - a).length_squared(), 1e-9), 0.0, 1.0)
		best = minf(best, p.distance_to(a + (b - a) * t))
	return best

## (Yasin 20 Nov: "DONT FORGET TO TAKE THE LAND INTO CONSIDERATION, build according to it"; SHORE_GUIDE: "your sand
## follows the land EXACTLY near the water") the ground of every ea piece: the land's own surface (n_ea_land.gd, bilinear
## on its 4 m nodes) + 5 cm, the 5 cm easing to 0 within 10 m of the 0 m line and 0 under the water (so the 0 m contour
## of the ground IS the land's, where the sea cuts it); within 12 m of a street walk eased onto the walk's measured
## height keeping the land's shape (target = land(p) + walk(f) - land(f); every walk is >= 4.9 cm over the land).
## World height (= local: the pieces sit at grid y 0).
static func g(u: float, v: float) -> float:
	var key := Vector2i(roundi(u * 200.0), roundi(v * 200.0))
	if _gc.has(key): return _gc[key]
	var land := LAND.at(u, v)
	var y := land
	if land > 0.0: y += LIFT * smoothstep(0.0, SHORE_EASE, shore_d(u, v))
	var w: Array = walk_foot(u, v)
	if float(w[0]) < EASE:
		var target := land + (float(w[1]) - LAND.at(float(w[2]), float(w[3])))
		y = lerpf(target, y, smoothstep(0.0, EASE, float(w[0])))
	_gc[key] = y
	return y

static func outline(name: String) -> PackedVector2Array:
	var f: Array = {"cape": OUT_CAPE, "shore": OUT_SHORE, "lens": OUT_LENS, "south": OUT_SOUTH}[name]
	var p := PackedVector2Array()
	for i in f.size() / 2: p.append(Vector2(f[i * 2], f[i * 2 + 1]))
	return p

## a strip polygon `w` m wide along a polyline (a path), ends square
static func strip(pts: Array, w: float) -> PackedVector2Array:
	var l := PackedVector2Array(); var r := PackedVector2Array()
	for i in pts.size():
		var a: Vector2 = pts[maxi(i - 1, 0)]; var b: Vector2 = pts[mini(i + 1, pts.size() - 1)]
		var d := (b - a).normalized(); var n := Vector2(-d.y, d.x) * w * 0.5
		var mit := 1.0
		if i > 0 and i < pts.size() - 1:
			var d1 := ((pts[i] as Vector2) - (pts[i - 1] as Vector2)).normalized()
			mit = 1.0 / maxf(cos(d1.angle_to(d) ), 0.5)
		l.append((pts[i] as Vector2) + n * mit); r.append((pts[i] as Vector2) - n * mit)
	r.reverse(); l.append_array(r)
	return l
static func rectp(u0: float, v0: float, u1: float, v1: float) -> PackedVector2Array:
	return PackedVector2Array([Vector2(u0, v0), Vector2(u1, v0), Vector2(u1, v1), Vector2(u0, v1)])
static func polyp(pts: Array) -> PackedVector2Array:
	var p := PackedVector2Array()
	for q in pts: p.append(q)
	return p

static func _area(p: PackedVector2Array) -> float:
	var a := 0.0
	for i in p.size(): a += p[i].x * p[(i + 1) % p.size()].y - p[(i + 1) % p.size()].x * p[i].y
	return a * 0.5

## Ground of a piece: cells of the global 2 m grid cut to the piece's outline; in each, the first region (a polygon and
## its material, "-" = a hole for a pad drawn by the script) takes its part; the rest is grass inside `grass` (the hand
## drawn grass side of the dune line) and sand outside it. Heights from yfn at every corner. Draws; decides nothing.
static var holes_seen := 0
static func fill(gr: K.Ground, out: PackedVector2Array, regions: Array, grass: PackedVector2Array, yfn: Callable, step := 2.0) -> void:
	var lo := Vector2(INF, INF); var hi := Vector2(-INF, -INF)
	for p in out: lo = lo.min(p); hi = hi.max(p)
	var rb: Array = []
	for r: Array in regions:
		var a := Vector2(INF, INF); var b := Vector2(-INF, -INF)
		for p in (r[0] as PackedVector2Array): a = a.min(p); b = b.max(p)
		rb.append(Rect2(a, b - a))
	var gb := Rect2()
	if not grass.is_empty():
		var a2 := Vector2(INF, INF); var b2 := Vector2(-INF, -INF)
		for p in grass: a2 = a2.min(p); b2 = b2.max(p)
		gb = Rect2(a2, b2 - a2)
	for i in range(floori(lo.x / step), ceili(hi.x / step)):
		for j in range(floori(lo.y / step), ceili(hi.y / step)):
			var x0 := i * step; var z0 := j * step
			var cell := PackedVector2Array([Vector2(x0, z0), Vector2(x0 + step, z0), Vector2(x0 + step, z0 + step), Vector2(x0, z0 + step)])
			var cr := Rect2(x0, z0, step, step)
			for part: PackedVector2Array in Geometry2D.intersect_polygons(cell, out):
				_split(gr, part, cr, regions, rb, 0, grass, gb, yfn)

static func _split(gr: K.Ground, part: PackedVector2Array, cr: Rect2, regions: Array, rb: Array, k: int, grass: PackedVector2Array, gb: Rect2, yfn: Callable) -> void:
	if part.size() < 3 or absf(_area(part)) < 1e-4: return
	while k < regions.size() and not (rb[k] as Rect2).intersects(cr): k += 1
	if k < regions.size():
		var rp: PackedVector2Array = regions[k][0]; var m := String(regions[k][1])
		for q: PackedVector2Array in Geometry2D.intersect_polygons(part, rp):
			if m != "-": _emit(gr, m, q, yfn)
		for q2: PackedVector2Array in Geometry2D.clip_polygons(part, rp):
			_split(gr, q2, cr, regions, rb, k + 1, grass, gb, yfn)
		return
	if grass.is_empty() or not gb.intersects(cr):
		_emit(gr, "grass" if (not grass.is_empty() and Geometry2D.is_point_in_polygon(cr.get_center(), grass)) else "sand", part, yfn)
		return
	for q: PackedVector2Array in Geometry2D.intersect_polygons(part, grass): _emit(gr, "grass", q, yfn)
	for q2: PackedVector2Array in Geometry2D.clip_polygons(part, grass): _emit(gr, "sand", q2, yfn)

static func _emit(gr: K.Ground, m: String, p: PackedVector2Array, yfn: Callable) -> void:
	if p.size() < 3: return
	if Geometry2D.is_polygon_clockwise(p) != _ccw_ref: holes_seen += 1; return
	if p.size() == 4 and _is_rect(p):
		gr.quad(m, Vector3(p[0].x, yfn.call(p[0].x, p[0].y), p[0].y), Vector3(p[1].x, yfn.call(p[1].x, p[1].y), p[1].y), Vector3(p[2].x, yfn.call(p[2].x, p[2].y), p[2].y), Vector3(p[3].x, yfn.call(p[3].x, p[3].y), p[3].y))
		return
	var idx := Geometry2D.triangulate_polygon(p)
	for t in range(0, idx.size(), 3):
		var a := p[idx[t]]; var b := p[idx[t + 1]]; var c := p[idx[t + 2]]
		gr.tri(m, Vector3(a.x, yfn.call(a.x, a.y), a.y), Vector3(b.x, yfn.call(b.x, b.y), b.y), Vector3(c.x, yfn.call(c.x, c.y), c.y))
static var _ccw_ref := Geometry2D.is_polygon_clockwise(PackedVector2Array([Vector2(0, 0), Vector2(1, 0), Vector2(1, 1), Vector2(0, 1)]))
static func _is_rect(p: PackedVector2Array) -> bool:
	for i in 4:
		var d := p[(i + 1) % 4] - p[i]
		if absf(d.x) > 1e-4 and absf(d.y) > 1e-4: return false
	return true

## one prop standing on the field at (x, z)
static func put(props: K.Props, yfn: Callable, base: String, cond: String, x: float, z: float, yaw := 0.0, collide := true) -> void:
	props.add(base, cond, Vector3(x, float(yfn.call(x, z)), z), yaw, collide)

