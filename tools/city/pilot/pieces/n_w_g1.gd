func _init() -> void: _run.call_deferred()

func _run() -> void:
	var c := L.new("n_w_g1", 4.15)
	var W := 91.0; var D := 177.0
	var land := func(x: float, z: float) -> float: return L.land_at(LAND, x, z) + 0.08
	var base := L.edged(land, W, D, EDGE_N, EDGE_S, EDGE_W, EDGE_E, 8.0)
	var SITES := [["commercial/com_bar_crown", Vector2(88.0, 12.0), "e", "anchor_bar"], ["apartments/apt_dingbat_teal", Vector2(88.0, 30.0), "e", "walkup_n"],
		["commercial/com_orange_row", Vector2(88.0, 62.0), "e", "laundry_pawn"], ["apartments/apt_dingbat_pink", Vector2(88.0, 86.0), "e", "walkup_s"],
		["apartments/apt_court_white", Vector2(88.0, 108.0), "e", "court_apts"], ["commercial/com_boutique_row", Vector2(16.0, 4.0), "n", "thrift_row"],
		["apartments/apt_townhouse_cays", Vector2(20.0, 175.0), "s", "townhouses"], ["commercial/com_orange_corner", Vector2(75.0, 175.0), "s", "corner_market"]]
	var pads: Array = []
	for st: Array in SITES:
		var r0: Array = L.bld_rect(String(st[0]), st[1], String(st[2]))
		pads.append([maxf(0.0, float(r0[0]) - 0.3), maxf(0.0, float(r0[1]) - 0.3), minf(W, float(r0[2]) + 0.3), minf(D, float(r0[3]) + 0.3)])
	var gl := L.grid_lots(0.0, 0.0, W, D, pads, base)
	c.terrain(gl.lots)
	c.skirt_depth = 0.5
	# ---- surfaces (first paint wins)
	c.paint("concrete", 88.0, 0.0, 91.0, 120.0)             # the row's frontage on the east street walk
	c.paint("concrete", 0.0, 0.0, 34.0, 4.0)                # thrift row's frontage
	c.paint("asphalt", 68.0, 39.0, 91.0, 47.0)              # driveway from the east apron (z 39..46.5)
	c.paint("asphalt", 30.0, 0.0, 44.0, 22.0)               # driveway from the north apron (x 33..42.5)
	c.paint("asphalt", 30.0, 22.0, 68.0, 60.0)              # the north lot behind the row
	c.paint("asphalt", 60.0, 124.0, 91.0, 134.0)            # driveway from the second east apron (z 125..132.5)
	c.paint("asphalt", 40.0, 120.0, 68.0, 155.0)            # the south lot
	c.paint("asphalt", 38.0, 155.0, 48.0, 177.0)            # its way out to the south apron (x 39..46.5)
	c.paint("gravel", 0.0, 60.0, 30.0, 155.0)               # the vacant lot
	c.paint("gravel", 30.0, 60.0, 34.0, 120.0)              # the utility easement (poles on gravel)
	c.paint("concrete", 0.0, 155.0, 38.0, 162.0)            # the townhouses' walk
	c.paint("grass", 0.0, 0.0, W, D)                        # yards: tired grass
	c.build_floor(L.rect_edges(0.0, 0.0, W, D))
	if c.stage == "ground": c.finish(); quit(); return
	var B := {}
	for k in SITES.size():
		c.y0 = float(gl.pads[k][4])
		B[String(SITES[k][3])] = c.bld(String(SITES[k][0]), SITES[k][1], String(SITES[k][2]), false, String(SITES[k][3]), 0.85)
	var shops: Array = [B.anchor_bar, B.laundry_pawn, B.thrift_row, B.corner_market]
	var homes: Array = [B.walkup_n, B.walkup_s, B.court_apts, B.townhouses]
	# ---- the east street row: life on the walk (bus stop, papers, a bench at the laundry, the bar's sandwich board)
	c.put("prop_bus_shelter", "worn", c.gp(89.6, 48.0), 90.0, "east street: a bus shelter for the apartment band and the gritty edge, facing the street")
	c.put("prop_bus_stop_sign", "worn", c.gp(90.4, 54.0), 90.0, "east street: the stop sign")
	c.put("prop_menu_board", "worn", c.gp(89.8, 9.0), 90.0, "the Anchor Bar: tonight's specials on the walk")
	for nb: Array in [[89.8, 20.0, "prop_newspaper_box_red"], [89.8, 21.0, "prop_newspaper_box_blue"]]: c.put(String(nb[2]), "worn", c.gp(float(nb[0]), float(nb[1])), 90.0, "east street: papers by the bar")
	c.put("prop_park_bench", "worn", c.gp(89.4, 74.0), 90.0, "coin laundry: a bench on the walk for people waiting on a wash, facing the street")
	c.put("prop_trash_receptacle", "worn", c.gp(88.6, 52.0), 0.0, "east street: a bin against the laundry's corner")
	c.put("prop_shopping_cart", "worn", c.gp(89.0, 96.0), 63.0, "east street: a shopping cart left on the walk")
	for bz: float in [26.0, 82.0]: c.put("prop_buzzer_panel", "worn", c.gp(88.2, bz), 90.0, "walk-up: the buzzer panel by the gate", false)
	# ---- the north lot and its driveways
	var sx := 33.0
	while sx < 66.0:
		c.stalls.append([sx, 26.0, 180.0, c.yf(sx, 26.0)]); c.stalls.append([sx, 56.0, 0.0, c.yf(sx, 56.0)])
		sx += 2.7
	c.put("prop_lot_light_pole", "worn", c.gp(50.0, 41.0), 0.0, "north lot: one light, half of it out")
	for ol: Array in [[38.4, 26.0], [49.2, 26.0], [43.8, 56.0], [57.3, 56.0]]: c.oil(Vector2(float(ol[0]), float(ol[1])), 0.0)
	c.tyre(Vector2(88.0, 43.0), -80.0, 6.0, 0.5); c.tyre(Vector2(37.75, 4.0), 0.0, 6.0, 0.5); c.cracks(30.0, 22.0, 68.0, 60.0, 14, 0.6); c.cracks(68.0, 39.0, 91.0, 47.0, 4, 0.6)
	# ---- the south lot
	var sz := 138.0
	while sz < 153.0:
		c.stalls.append([43.0, sz, 90.0, c.yf(43.0, sz)]); c.stalls.append([64.0, sz, -90.0, c.yf(64.0, sz)])
		sz += 2.7
	c.put("prop_lot_light_pole", "worn", c.gp(54.0, 140.0), 0.0, "south lot: a light")
	c.tyre(Vector2(88.0, 129.0), -80.0, 6.0, 0.5); c.tyre(Vector2(43.0, 172.0), 0.0, 6.0, 0.5); c.cracks(40.0, 120.0, 68.0, 155.0, 10, 0.6)
	c.oil(Vector2(43.0, 143.4), 90.0); c.oil(Vector2(64.0, 148.8), 90.0)
	# ---- the vacant lot: a weathered board fence along the lot side, weeds, a cart, an old drum
	c.fence("fence_weathered_board", "fence_post_privacy", 2.0, Vector2(30.0, 60.5), Vector2(30.0, 154.5), "vacant lot: an old board fence along the lot side")
	c.fence("fence_weathered_board", "fence_post_privacy", 2.0, Vector2(0.6, 154.5), Vector2(30.0, 154.5), "vacant lot: the board fence behind the townhouses")
	for ag: Array in [[8.0, 80.0], [16.0, 98.0], [22.0, 120.0], [10.0, 140.0], [6.0, 112.0]]: c.put("plant_agave_americana_small", "normal", c.gp(float(ag[0]), float(ag[1])), c.rr.randf_range(0, 360), "vacant lot: weeds and self-sown agave")
	c.put("prop_shopping_cart", "worn", c.gp(14.0, 128.0), 110.0, "vacant lot: a shopping cart dumped over the fence")
	c.put("prop_channelizer_drum", "worn", c.gp(24.0, 90.0), 0.0, "vacant lot: an old drum")
	c.put("prop_container_20ft_red", "rusty", c.gp(8.0, 70.0), 0.0, "vacant lot: a rusting container someone left")
	# ---- the block wall to the gravel yards (tagged), from the thrift row's back to the vacant lot's board fence
	c.cmu(Vector2(0.6, 20.0), Vector2(0.6, 154.5), "gritty side: a block wall to the gravel yards next door, tagged")
	# ---- utility poles on gravel pads in the rear easement
	for pz: float in [64.0, 92.0, 118.0]: c.put("prop_utility_pole", "worn", c.gp(32.0, pz), 0.0, "rear easement: the power line on poles, on gravel")
	c.put("prop_utility_pole_transformer", "worn", c.gp(32.0, 78.0), 0.0, "rear easement: the block's transformer pole")
	# ---- the walk-ups' yards: clotheslines, bin carts (services), a bike
	for cl: Array in [[64.0, 30.0], [64.0, 86.0]]: c.put("prop_clothesline", "worn", c.gp(float(cl[0]), float(cl[1])), 90.0, "walk-up: washing out in the back yard")
	c.put("prop_bike_rack", "worn", c.gp(74.0, 114.0), 90.0, "court apartments: residents' bikes beside the court")
	# ---- the south street: the townhouses' walk, the corner market's front
	c.put("prop_ice_chest", "worn", c.gp(82.2, 168.0), 90.0, "corner market: the ice chest against its east wall")
	c.put("prop_newspaper_box_red", "worn", c.gp(67.6, 174.0), 0.0, "corner market: papers by the door")
	c.put("prop_trash_receptacle", "worn", c.gp(82.4, 172.6), 0.0, "corner market: a bin against its corner")
	c.put("prop_usps_collection_box", "worn", c.gp(36.0, 176.0), 0.0, "south street: the mailbox at the townhouses' end")
	# ---- thrift row: a rail of clothes outside is inside the shop; a bench and bin outside
	c.put("prop_park_bench", "worn", c.gp(30.0, 1.4), 180.0, "thrift row: a bench on the walk facing the street")
	c.put("prop_trash_receptacle", "worn", c.gp(3.6, 3.0), 0.0, "thrift row: a bin against its west end")
	# ---- service sides, door grime (heavy wear)
	for r: Dictionary in shops: c.services(r, 2.0, 1, false)
	for r2: Dictionary in homes: c.services(r2, 2.0, 2, true)
	for r3: Dictionary in shops + homes:
		for dr2: Array in r3.doors:
			var q: Vector3 = dr2[1]; var o: Vector3 = dr2[2]
			c.grime(Vector2(q.x + o.x * 0.9, q.z + o.z * 0.9), 0.0, 1.8, 1.6, 0.6)
	c.put("prop_dumpster_3yd_green", "worn", c.gp(69.0, 120.0), 0.0, "the row's waste, against the court apartments' back wall")
	c.put("prop_dumpster_3yd_blue", "worn", c.gp(72.6, 120.0), 0.0, "the row's recycling, beside it")
	c.finish()
	quit()
