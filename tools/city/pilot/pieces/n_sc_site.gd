## nearest point of a polyline table to p: [distance, the edge's offset over the land there]
static func _near(t: Array, p: Vector2) -> Array:
	var best := INF; var off := 0.0
	for i in t.size() - 1:
		var a := Vector2(t[i][0], t[i][1]); var b := Vector2(t[i + 1][0], t[i + 1][1])
		var s := clampf((p - a).dot(b - a) / maxf((b - a).length_squared(), 1e-9), 0.0, 1.0)
		var f := a + (b - a) * s
		var d := p.distance_to(f)
		if d < best:
			best = d
			off = lerpf(float(t[i][2]), float(t[i + 1][2]), s) - LAND.at(f.x, f.y)
	return [best, off]

## world height of region `r`'s ground at (u, v)
static func g(r: String, u: float, v: float) -> float:
	var p := Vector2(u, v)
	var sw := 0.0; var so := 0.0; var dmin := INF
	for t: Array in REG[r]:
		var n := _near(t, p)
		var d: float = n[0]
		dmin = minf(dmin, d)
		var w := 1.0 / (d * d + 1e-8)
		sw += w; so += w * float(n[1])
	var off := so / sw
	return LAND.at(u, v) + lerpf(off, LIFT, smoothstep(0.0, EASE, dmin))

## a table read as a function: the second coordinate at the first (kx 0: v at u; kx 1: u at v), linear, clamped
static func f(t: Array, kx: int) -> Callable:
	var ky := 1 - kx
	return func(x: float) -> float:
		for i in t.size() - 1:
			var a: float = t[i][kx]; var b: float = t[i + 1][kx]
			if (x - a) * (x - b) <= 0.0 and absf(b - a) > 1e-9:
				return lerpf(float(t[i][ky]), float(t[i + 1][ky]), (x - a) / (b - a))
		return float(t[t.size() - 1][ky]) if absf(x - float(t[t.size() - 1][kx])) < absf(x - float(t[0][kx])) else float(t[0][ky])

## ground between two edges that run along z: rows on the global grid in z (z0 .. z1, every `step`), x from xl(z) to xr(z),
## columns on the global grid, the first / last cell of each row a trapezoid to the edge; each cell takes the first paint
## [x0, z0, x1, z1, mat] holding its centre ("-" = hole), else `base`. (hs_fill_lib.paint_band turned a quarter.)
static func paint_rows(gr, z0: float, z1: float, xl: Callable, xr: Callable, paints: Array, base: String, yfn: Callable, step := 1.0) -> void:
	const HL := preload("res://tools/city/pilot/pieces/hs_fill_lib.gd")
	var ex: Array = []; var ez: Array = []
	for p: Array in paints: ex.append_array([float(p[0]), float(p[2])]); ez.append_array([float(p[1]), float(p[3])])
	var zs := HL._lines(z0, z1, step, ez)
	for j in zs.size() - 1:
		var za: float = zs[j]; var zb: float = zs[j + 1]
		var la: float = xl.call(za); var lb: float = xl.call(zb); var ra: float = xr.call(za); var rb: float = xr.call(zb)
		var inner := HL._lines(maxf(la, lb), minf(ra, rb), step, ex)
		inner.pop_front(); inner.pop_back()
		var xa: Array = [la]; var xb: Array = [lb]
		for x: float in inner: xa.append(x); xb.append(x)
		xa.append(ra); xb.append(rb)
		for c in xa.size() - 1:
			var cz := (za + zb) * 0.5; var cx := (float(xa[c]) + float(xa[c + 1]) + float(xb[c]) + float(xb[c + 1])) * 0.25
			var m := base
			for p: Array in paints:
				if cx > float(p[0]) and cx < float(p[2]) and cz > float(p[1]) and cz < float(p[3]): m = String(p[4]); break
			if m == "-": continue
			gr.quad(m, Vector3(xa[c], yfn.call(xa[c], za), za), Vector3(xa[c + 1], yfn.call(xa[c + 1], za), za),
				Vector3(xb[c + 1], yfn.call(xb[c + 1], zb), zb), Vector3(xb[c], yfn.call(xb[c], zb), zb))
