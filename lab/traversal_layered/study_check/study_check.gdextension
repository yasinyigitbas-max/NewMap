[configuration]
entry_symbol = "study_check_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://study_check/native/bin/libstudycheck.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://study_check/native/bin/libstudycheck.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://study_check/native/bin/libstudycheck.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://study_check/native/bin/libstudycheck.windows.template_debug.x86_64.dll"
