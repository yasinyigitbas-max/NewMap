[configuration]
entry_symbol = "layered_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/bin/liblayered.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/liblayered.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://native/bin/liblayered.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/liblayered.windows.template_debug.x86_64.dll"
