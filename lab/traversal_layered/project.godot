; Experiment B (layered, GTA-style) traversal lab. Its own project: never loads the game.
config_version=5

[application]
config/name="Traversal Lab B (layered)"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=false

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=true

[rendering]
anti_aliasing/quality/msaa_3d=2
